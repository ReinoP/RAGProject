@page
@{
}

<div class="min-h-screen" id="app">
    <!-- TopNavBar -->
    <header class="fixed left-0 top-0 w-full z-50 bg-slate-50/80 dark:bg-slate-900/80 backdrop-blur-xl shadow-sm dark:shadow-none">
        <div class="flex justify-between items-center px-6 py-4 max-w-7xl mx-auto">
            <div class="flex items-center gap-8">
                <span class="text-xl font-bold tracking-tighter text-indigo-700 dark:text-indigo-300 font-headline">RAG demo</span>
            </div>
            <div class="flex items-center gap-4">
                <button @@click="setShowDeleteModal(true)" class="primary-gradient text-on-primary px-5 py-2 rounded-xl text-sm font-semibold active:scale-95 transition-transform shadow-md">
                    Reset RAG Data
                </button>
            </div>
        </div>
    </header>
    <!-- Main Canvas -->
    <main  class="pt-24 pb-12 px-6">
        <!-- Scrollable messages container. The max-height uses calc so it stays between the fixed header and the fixed input. -->
        <div ref="messageContainer" class="max-h-[75vh] overflow-y-auto scroll-smooth max-w-3xl mx-auto space-y-16 mb-4">
            <div class="w-full max-w-3xl px-6 mx-auto space-y-8">
                <div  class="max-h-[calc(100vh-12rem)] space-y-8">
                    <div v-for="message in chatHistory" :key="message.id">
                        <!-- User Question --> 
                        <div v-if="message.type === 'user'" class="flex flex-col items-end ml-auto space-y-2">
                            <div class="bg-primary-container text-on-primary-container px-6 py-4 rounded-2xl rounded-tr-none max-w-[85%] min-w-[120px] shadow-sm flex flex-col text-right">
                                <div v-html="message.content"></div>
                                <div class="self-end text-[10px] font-semibold text-outline mt-1">
                                    {{ renderTimeStamp(message.timestamp) }}
                                </div>
                            </div>
                        </div>
                        <!-- AI Answer -->
                        <div v-if="message.type === 'ai'" class="flex flex-col items-start space-y-2 group">
                            <div class="bg-primary-container text-on-primary-container px-6 py-4 rounded-2xl rounded-tl-none max-w-[85%] min-w-[120px] shadow-sm flex flex-col text-left">
                                <div v-html="message.content"></div>
                                <div class="self-start text-[10px] font-semibold text-outline mt-1">
                                    {{ renderTimeStamp(message.timestamp) }}
                                </div>
                            </div>
                        </div>
             
                    </div>
                </div>
            </div>
            <!-- Input Area -->
            <div class="fixed bottom-4 left-1/2 transform -translate-x-1/2 w-full max-w-3xl px-6 z-50">
                <div class="glass-effect p-2 rounded-2xl shadow-xl border border-white/20">
                    <div class="relative flex items-center bg-surface-container-lowest rounded-xl p-1.5 transition-all focus-within:ring-2 focus-within:ring-primary/20">
                        <div class="flex-grow flex items-center px-4">
                            <span class="material-symbols-outlined text-outline mr-3" data-icon="temp_preferences_custom">temp_preferences_custom</span>
                            <input @@keyup.enter="sendMessage" class="w-full bg-transparent border-none focus:ring-0 text-on-surface placeholder:text-outline font-body py-3 text-sm" placeholder="Ask anything..." type="text" v-model="userInput"/>
                        </div>
                        <div class="flex items-center gap-2 pr-2">
                            <button class="p-2 text-outline hover:text-primary hover:bg-primary-container rounded-lg transition-all" @@click="setShowUploadModal(true)"  >
                                <span class="material-symbols-outlined" data-icon="attach_file" >attach_file</span>
                            </button>
                            <button @@click="sendMessage" class="primary-gradient text-white flex items-center gap-2 px-6 py-2.5 rounded-lg font-headline font-bold text-sm shadow-lg active:scale-95 transition-transform">
                                <span>Ask</span>
                                <span class="material-symbols-outlined text-sm" data-icon="send">send</span>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="mt-3 text-center">
                    <p class="text-[10px] text-outline font-medium tracking-wide">AI MAY DISPLAY INACCURATE INFO. VERIFY IMPORTANT DETAILS.</p>
                </div>
            </div>

            <div id="toast" class="toast"></div>

            <!-- Modal Overlay for Upload -->
            <div v-if="showUploadModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50">
                <div class="bg-white dark:bg-slate-800 rounded-xl shadow-xl max-w-lg w-full p-6 relative">
                    <button @@click="setShowUploadModal(false)" class="absolute top-2 right-3 text-gray-500 hover:text-gray-700 dark:hover:text-gray-300">
                        ✕
                    </button>

                    <h2 class="text-xl font-bold mb-4">Upload File</h2>
                    <p class="mb-4 text-sm text-gray-600 dark:text-gray-300">
                        Select a file to upload to RAG.
                        Please insert pre-processed data only, e.g. no html/markdown or table formats.
                    </p>
                    <p class="fw-bold mb-2">
                        Only upload .txt files.
                    </p>

                    <div class="flex items-center gap-2">
                        <input type="file" id="file" class="hidden" @@change="fileSelected"/>

                        <button class="bg-gray-200 hover:bg-gray-300 px-4 py-2 rounded" onclick="document.getElementById('file').click()">
                            Choose file
                        </button>

                        <span id="fileName" v-if="!fileInput">No file chosen</span>
                    </div>

                    <div class="flex justify-end gap-3">
                        <button @@click="setShowUploadModal(false)" class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 bg-gray-200 hover:bg-gray-300">
                            Cancel
                        </button>
                        <button class="px-4 py-2 rounded-lg bg-indigo-600 text-white hover:bg-indigo-700" @@click="uploadFile" style="display: inline-flex;">
                            <span>{{ loading ? 'Uploading...' : 'Upload' }}</span>
                            <span v-if="loading" class="mr-2">
                                  <svg v-if="loading" class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                                  </svg>
                            </span>
                        </button>
                    </div>
                    <div v-if="invalidFileType">
                        <p class="text-red-500">Invalid file type.</p>
                    </div>
                  <div v-if="dataUploadtatus && dataUploadtatus != 200">
                        <p class="text-red-500">Something went wrong with the upload.</p>
                    </div>
                    
                </div>
            </div>

            @* Delete-Modal *@
              <div v-if="showDeleteModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50">
                <div class="bg-white dark:bg-slate-800 rounded-xl shadow-xl max-w-lg w-full p-6 relative">
                    <button @@click="setShowDeleteModal(false)" class="absolute top-2 right-3 text-gray-500 hover:text-gray-700 dark:hover:text-gray-300">
                        ✕
                    </button>

                    <h2 class="text-xl font-bold mb-4">Delete data</h2>
                    <p class="mb-4 text-sm text-gray-600 dark:text-gray-300">
                       Are you sure you want to delete all previously uploaded data?
                    </p>
                    <div class="flex justify-end gap-3">
                        <button @@click="setShowDeleteModal(false)" class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 bg-gray-200 hover:bg-gray-300">
                            Cancel
                        </button>
                        <button class="px-4 py-2 rounded-lg bg-red-600 text-white hover:bg-red-700" @@click="resetRAGData" style="display: inline-flex;">
                            <span>{{ loading ? 'Deleting...' : 'Delete' }}</span>
                            <span v-if="loading" class="mr-2">
                                  <svg v-if="loading" class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                                  </svg>
                            </span>
                        </button>
                    </div>
                    <div v-if="dataDeletionStatus && dataDeletionStatus != 200">
                        <p class="text-red-500">Something went wrong with the deletion.</p>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
    tailwind.config = {
        darkMode: "class",
        theme: {
            extend: {
                colors: {
                    "primary": "#0053db",
                    "primary-container": "#dbe1ff",
                    "on-primary": "#f8f7ff",
                    "on-primary-container": "#0048bf",
                    "surface-container-lowest": "#ffffff",
                    "on-surface": "#2a3439",
                    "outline": "#717c82"
                },
                fontFamily: {
                    "headline": ["Manrope"],
                    "body": ["Inter"],
                    "label": ["Inter"]
                },
                borderRadius: {"DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px"},
            },
        },
    }
</script>
<style>
    .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        vertical-align: middle;
    }
    .glass-effect {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
    }
    .primary-gradient {
        background: linear-gradient(135deg, #0053db 0%, #0048c1 100%);
    }

    .toast {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: #333;
      color: white;
      padding: 12px 16px;
      border-radius: 6px;
      opacity: 0;
      transform: translateY(20px);
      transition: all 0.3s ease;
      pointer-events: none;
    }

    .toast.show {
      opacity: 1;
      transform: translateY(0);
    }

    .toast.success {
      background: #2e7d32;
    }

    .toast.error {
      background: #c62828;
    }
</style>
<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

<script>
    
    const app = Vue.createApp({
        data() {
            return {
                answerText: null,
                questionText: null,
                chatHistory:[],
                isSending: false,
                userInput: '',
                activeTab:null,
                currentNav: "Chat",
                latestAIAnsweId :null,
                currentChatId: null,
                fileInput: null,
                showUploadModal:false,
                showDeleteModal:false,
                loading:false,
                invalidFileType: false,
                dataDeletionStatus: null,
                dataUploadtatus: null

            };
       },
       watch:{
            // Auto-scroll when messages change
            chatHistory(newVal, oldVal){
                // wait for DOM update then scroll
                this.$nextTick(() => {
                    this.scrollToBottom();
                });
            }
       },
        methods: {
            showToast(message, type = "success", duration = 3000) {
              const toast = document.getElementById("toast");

              toast.textContent = message;
              toast.className = `toast show ${type}`;

              setTimeout(() => {
                toast.className = "toast";
              }, duration);
            },
            async scrollToBottom(){
                   await this.$nextTick();
                   const el = this.$refs.messageContainer;
                   if (el && typeof el.scrollTop !== 'undefined') {
                        el.scrollTop = el.scrollHeight;
                   }
             },
            async sendMessage() {
                let date = Date.now();

                if (!this.userInput || this.userInput.trim() === '') {
                    this.chatHistory.push({id:this.currentChatId + 1, type:"ai",  content:"Im sorry, what did you want?", timestamp: date});
                    return;
                }
                let prompt = this.userInput;
                this.userInput = '';
             
                this.currentChatId = this.chatHistory[this.chatHistory.length -1]?.id;
                if(!this.currentChatId){
                    this.currentChatId = 1;
                }

                this.chatHistory.push({id:this.currentChatId, type:"user",  content:prompt, timestamp: date});
                await this.scrollToBottom();

                this.isSending = true;
                try {
                    let res = await fetch("/api/ai/AskAI", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ id:this.currentChatId, input: prompt })
                    });

                    if (res && res.status === 200) {
                        let data = await res.json();
                        this.chatHistory.push(data);
                        this.latestAIAnsweId = data.id;
                        await this.scrollToBottom();

                    }
                } catch (e) {
                    //TODO some ui error thing?
                    console.error("error", e);
                } finally {
                    this.isSending = false;
                }
            },
            renderTimeStamp(ts){
                const date = ts < 1e12 ? new Date(ts * 1000) : new Date(ts);
                const finnishDate = new Intl.DateTimeFormat('fi-FI', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(date);
                const finnishTime = new Intl.DateTimeFormat('fi-FI', { hour: '2-digit', minute: '2-digit' }).format(date);
                return finnishDate + " " + finnishTime
            },
            setShowUploadModal(val){
                this.showUploadModal = val;
                if(!val){
                    this.fileInput = null;
                }
            },
            setShowDeleteModal(val){
                this.showDeleteModal = val;
            },
            async resetRAGData(){
                this.dataDeletionStatus = null;

                if(this.showDeleteModal){
                    let res = await fetch("/api/api/DeleteRAGData", {
                        method: 'DELETE',
                    });

                    if(res){
                        this.dataDeletionStatus = res.status;
                        if(this.dataDeletionStatus == 200){
                            this.setShowDeleteModal(false);
                            this.showToast("Data deleted successfully", "success");
                        }
                    }
                    else{
                        this.dataDeletionStatus = 500;
                    }
                }
            },
            fileSelected(event){
                if(!event || !event.target || !event.target.files){
                   return
               }

                this.fileInput = event.target.files[0];

               if(!this.isValidFile(this.fileInput)){
                   this.fileInput = null;
                   return;
               }
            },
           async uploadFile(){
               this.dataUploadtatus = null;
                if(!this.fileInput){
                    //TODO some ui notification?
                    console.warn("no file found")
                    return;
                }

               this.loading = true;
               let formData = new FormData();
              
               formData.append("file", this.fileInput);

               let res = await fetch("/api/api/UploadFile", {
                             method: "POST",
                            body: formData
                          });

               if(res){
                   this.dataUploadtatus = res.status;
                   if(this.dataUploadtatus == 200){
                        this.setShowUploadModal(false);
                        this.showToast("Data uploaded successfully", "success")
                   }
               }
               else{
                   this.dataUploadtatus = 500;
               }
               this.loading = false;

            },
            isValidFile(file) {
               this.invalidFileType = false;

                if(!file){
                    return true;
                }
                let ext = file.name?.split('.').pop().toLowerCase();

                if (file.type !== 'text/plain' || ext !== "txt"){
                    this.invalidFileType = true;
                    return false;
                }
              
              return true;
            },
        },
        mounted(){
            let time = Date.now();
            this.chatHistory.push({id:1, type:"ai", content:"Hello there! I am an AI assistant here to help you. I use Retrieval-augmented generation to answer your questions.", timestamp:time});
            this.$nextTick(() => {
                this.scrollToBottom();
            });
        }
     });

    app.mount('#app');

</script>