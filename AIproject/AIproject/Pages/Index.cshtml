@page
@model AIproject.Pages.ChatPageModel
@{
}

<div class="min-h-screen" id="app">
    <!-- TopNavBar -->
    <header class="fixed left-0 top-0 w-full z-50 bg-slate-50/80 dark:bg-slate-900/80 backdrop-blur-xl shadow-sm dark:shadow-none">
        <div class="flex justify-between items-center px-6 py-4 max-w-7xl mx-auto">
            <div class="flex items-center gap-8">
                <span class="text-xl font-bold tracking-tighter text-indigo-700 dark:text-indigo-300 font-headline">My AI miniproject</span>
            </div>
            <div class="flex items-center gap-4">
                <button @@click="resetRAGData" class="primary-gradient text-on-primary px-5 py-2 rounded-xl text-sm font-semibold active:scale-95 transition-transform shadow-md">
                    Reset RAG Data
                </button>
            </div>
        </div>
    </header>
    <!-- Main Canvas -->
    <main class="lg:ml-64 pt-24 pb-12 px-6">
        <div class="max-w-3xl mx-auto space-y-16">
        <div class="space-y-8 ">
            <!-- Scrollable messages container. The max-height uses calc so it stays between the fixed header and the fixed input. -->
            <div ref="messageContainer" class="max-h-[calc(100vh-12rem)] overflow-y-auto scroll-smooth space-y-8">
                <div v-for="message in chatHistory" :key="message.id">
                    <!-- User Question --> 
                    <div v-if="message.type === 'user'" class="flex flex-col items-end ml-auto space-y-2">
                        <div class="bg-primary-container text-on-primary-container px-6 py-4 rounded-2xl rounded-tr-none max-w-[85%] min-w-[120px] shadow-sm flex flex-col text-right">
                            <div v-html="message.content"></div>
                            <div class="self-end text-[10px] font-semibold text-outline mt-1">
                                {{ renderTimeStamp(message.timestamp) }}
                            </div>
                        </div>
                    </div>
                    <!-- AI Answer -->
                    <div v-if="message.type === 'ai'" class="flex flex-col items-start space-y-2 group">
                        <div class="bg-primary-container text-on-primary-container px-6 py-4 rounded-2xl rounded-tl-none max-w-[85%] min-w-[120px] shadow-sm flex flex-col text-left">
                            <div v-html="message.content"></div>
                            <div class="self-start text-[10px] font-semibold text-outline mt-1">
                                {{ renderTimeStamp(message.timestamp) }}
                            </div>
                        </div>
                    </div>
             
                </div>
            </div>
        </div>
        <!-- Input Area -->
        <div class="fixed bottom-4 left-1/2 transform -translate-x-1/2 w-full max-w-3xl px-6 z-50">
            <div class="glass-effect p-2 rounded-2xl shadow-xl border border-white/20">
                <div class="relative flex items-center bg-surface-container-lowest rounded-xl p-1.5 transition-all focus-within:ring-2 focus-within:ring-primary/20">
                    <div class="flex-grow flex items-center px-4">
                        <span class="material-symbols-outlined text-outline mr-3" data-icon="temp_preferences_custom">temp_preferences_custom</span>
                        <input @@keyup.enter="sendMessage" class="w-full bg-transparent border-none focus:ring-0 text-on-surface placeholder:text-outline font-body py-3 text-sm" placeholder="Ask anything..." type="text" v-model="userInput"/>
                    </div>
                    <div class="flex items-center gap-2 pr-2">
                        <button class="p-2 text-outline hover:text-primary hover:bg-primary-container rounded-lg transition-all" @@click="setShowUploadModal(true)"  >
                            <span class="material-symbols-outlined" data-icon="attach_file" >attach_file</span>
                        </button>
                        <button @@click="sendMessage" class="primary-gradient text-white flex items-center gap-2 px-6 py-2.5 rounded-lg font-headline font-bold text-sm shadow-lg active:scale-95 transition-transform">
                            <span>Ask</span>
                            <span class="material-symbols-outlined text-sm" data-icon="send">send</span>
                        </button>
                    </div>
                </div>
            </div>
            <div class="mt-3 text-center">
            <p class="text-[10px] text-outline font-medium tracking-wide">AI MAY DISPLAY INACCURATE INFO. VERIFY IMPORTANT DETAILS.</p>
            </div>
        </div>
        <!-- Modal Overlay -->

        <div v-if="showUploadModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50">
            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-xl max-w-lg w-full p-6 relative">
                <button @@click="showUploadModal = false" class="absolute top-2 right-3 text-gray-500 hover:text-gray-700 dark:hover:text-gray-300">
                    ✕
                </button>

                <h2 class="text-xl font-bold mb-4">Upload File</h2>
                <p class="mb-4 text-sm text-gray-600 dark:text-gray-300">
                    Select a file to upload to RAG.
                    Please insert pre-processed data only, e.g. no html/markdown or table formats. Only upload .txt files.
                </p>
                <input type="file" class="mb-4 w-full" @@change="fileSelected" />
                <div class="flex justify-end gap-3">
                    <button @@click="showUploadModal = false" class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200">
                        Cancel
                    </button>
                    <button class="px-4 py-2 rounded-lg bg-indigo-600 text-white hover:bg-indigo-700" @@click="uploadFile" style="display: inline-flex;">
                        <span>{{ loading ? 'Uploading...' : 'Upload' }}</span>
                        <span v-if="loading" class="mr-2">
                              <svg v-if="loading" class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                              </svg>
                        </span>
                    </button>
                </div>
                <div v-if="invalidFileType">
                    <p class="text-red-500">Invalid file type.</p>
                </div>
            </div>
        </div>
    </div>

    </main>
    <!-- Status Badge -->
    <div class="fixed bottom-6 right-6 z-50">
        <div class="bg-tertiary-container text-on-tertiary-container px-4 py-1.5 rounded-full flex items-center gap-2 shadow-lg animate-pulse border border-white/50">
            <span class="w-2 h-2 rounded-full bg-primary"></span>
            <span class="text-[11px] font-bold tracking-tight uppercase">System Online</span>
        </div>
    </div>
</div>
