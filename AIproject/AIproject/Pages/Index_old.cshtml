@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
    <div id="aiApp" class="text-center">
        <h1 class="display-4">Welcome</h1>
        <div>
            <input type="text" id="userInput" placeholder="Type in your question" @@keyup.enter="askAI" class="mr-2"/>
            <button type="button" @@click="askAI" class="" >Ask AI</button>
        </div>
        <div class="mt-2 ">
            <div v-if="questionText">
                <h4>You asked</h4>
                <span> {{questionText}}</span>
            </div>
            <div v-if="answerText" class="mt-2">
                <h4>The computer says</h4>
                <span>{{answerText}}</span>
            </div>
        </div>
    </div>

<script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
<script>
    const app = Vue.createApp({
        data() {
            return {
                answerText: null,
                questionText: null,
            };
       },
        methods: {
            changeMessage() {
                this.message = "Viestin sisältö vaihtui!";
            },
            async askAI() {
                let inputEl = document.getElementById("userInput");
                let prompt = inputEl.value;

                inputEl.value = null;

                const res = await fetch("/api/ai/AskAI", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({input: prompt })
                });

                console.log(res.js)

                if(res != null && res.status == 200){
                    const data = await res.json();
                    this.questionText = prompt;
                    this.answerText = data.message;
                }
                else{
                    this.answerText = "Something went wrong, and I cannot answer the question.";
                    this.questionText = prompt;
                }
            }
        }
     });

    app.mount('#aiApp');
</script>